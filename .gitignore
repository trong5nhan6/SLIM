# Dataset (regenerate with data/scripts/convert_visdrone.py; VisDrone2019-DET is not ours to redistribute)
datasets/
# Results: only the experiment table is tracked (it drives every run in this repo);
# the raw eval dumps stay local. `results/*` not `results/`, because git cannot re-include
# a file whose parent DIRECTORY is excluded.
results/*
!results/SOTA-SLIM.xlsx
final report/
weights/
notes/
# Training runs (weights, plots, csv logs) — reproducible from a run, not source
runs/

# Text training logs (logs/<name>.log, xem models/base_model.py) — reproducible from a run
logs/

# Pretrained weights auto-downloaded by ultralytics (e.g. yolo11n.pt for --idea baseline)
*.pt

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# Editors
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
